TRADING_MODE=paper
SYMBOL=BTCUSD
INITIAL_CASH=10000
PREDICTION_SHORT_WINDOW=5
PREDICTION_LONG_WINDOW=20
PREDICTION_THRESHOLD=0.02
MAX_POSITION_FRACTION=0.25
MAX_ORDER_NOTIONAL=2500
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.06
ALLOW_SHORT=false

# Anthropic Claude predictor (optional, install the `llm` extra to enable).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
